# Your Anthropic API key. Used for visitors who don't bring their own.
# Leave empty to make every visitor paste their own key.
ANTHROPIC_API_KEY=

# Caps on hosted (your-key) runs. Each critique or image check counts as one run.
DAILY_LIMIT=60
PER_VISITOR_DAILY_LIMIT=6

# Optional: Upstash Redis REST credentials, so the caps hold across serverless instances.
# Without these, counts are kept in memory per instance (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
